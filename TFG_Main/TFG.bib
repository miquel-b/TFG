
@book{massaki_gemba_2015,
	title = {Gemba Kaizen. Un enfoque hacia la mejora continua de la estrategia, 2{ªEd}.},
	abstract = {Segunda edición de Gemba Kaizen que aporta una revisión en profundidad de su primer trabajo, ya un clásico reputado. El libro revela cómo implementar mejoras que sean eficaces y rentables en los procesos más críticos de una empresa. Para medrar en la economía actual de un mundo competitivo, las organizaciones requieren la m áxima eficacia y los máximos beneficios en sus operaciones respecto a cualquier tiempo pasado. Son factores esenciales para el éxito la capacidad de resolución de problemas, el incremento de la productividad, la mejora de la calidad y la reducción de gastos. En esta guía se recogen estrategias probadas para logar tales objetivos. Su autor, Masaaki Imai, fundador de Kaizen Institute, es pionero del concepto moderno de excelencia en las operaciones},
	pagetotal = {580},
	author = {Massaki, Imai and Sanchez, Cristina},
	date = {2015-09-15},
}

